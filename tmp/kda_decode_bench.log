        qr, kr, vr, g = mk(B, H, K), mk(B, H, K), mk(B, H, V), mk(B, H, K)
        beta, go = mk(B, H), mk(B, H, V)
        a_log = jnp.asarray(np.log(rng.uniform(1, 16, H)), jnp.float32)
        dtb = mk(H, K) * 0.1
        wq, wk, wv = (mk(4, H, K) * 0.3 for _ in range(3))
