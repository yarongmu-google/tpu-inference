        B, H, K, V = 8, 16, 128, 128
        nb = 2 * B
        idx_np = rng.permutation(nb)[:B]
        idx = jnp.asarray(idx_np, jnp.int32)
        mk = lambda *s: jnp.asarray(rng.standard_normal(s), jnp.float32)
        pool0, cq0, ck0, cv0 = (mk(nb, H, K, V) * 0.1, mk(nb, 3, H, K),
