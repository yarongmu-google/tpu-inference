            (P_DEV,), ("x",),
            abstract_device=mesh_lib.AbstractDevice(
                device_kind="TPU7x", num_cores=1, platform="tpu"))
        fn = functools.partial(
            fused_moe_decode_tp_fused,
            router_fused=False,
            mesh=amesh,
            axis_name="x",
            top_k=k,
            renormalize_topk_logits=True,
            capacity=32,
            be=4,
            bg=2,
            interpret=False,
        )
