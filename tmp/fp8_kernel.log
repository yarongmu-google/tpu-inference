        d, e, i, k = 256, 16, 128, 4
        i_loc = i // P_DEV
        rng = np.random.default_rng(0)
        tokens = jnp.asarray(rng.standard_normal((t, d)), jnp.bfloat16)
        gating = jnp.asarray(rng.standard_normal((t, e)), jnp.float32)
