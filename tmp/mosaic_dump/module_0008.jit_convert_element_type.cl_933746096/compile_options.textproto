    xla_cpu_collective_call_terminate_timeout_seconds: 40
    xla_cpu_collective_call_warn_stuck_seconds: 20
    xla_keep_shardings_after_spmd: false
    xla_gpu_use_embeded_device_lib: true
    xla_gpu_experimental_enable_triton_warp_specialization: false
